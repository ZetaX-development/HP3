    .security-inner { position: relative; z-index: 1; }

    /* ─── F: CONTACT GRADIENT MESH ─── */
    .contact-section-dark {
      background: var(--text-primary);
      position: relative; overflow: hidden;
    }
    .contact-mesh {
      position: absolute; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 60% 80% at 10% 50%, rgba(26,63,191,0.28) 0%, transparent 62%),
        radial-gradient(ellipse 50% 70% at 88% 30%, rgba(123,150,255,0.22) 0%, transparent 55%),
        radial-gradient(ellipse 40% 60% at 55% 88%, rgba(26,63,191,0.16) 0%, transparent 52%);
      animation: meshDrift 14s ease-in-out infinite alternate;
    }
    @keyframes meshDrift {
      0%   { transform: scale(1)    translate(0, 0); }
      33%  { transform: scale(1.07) translate(-2%, 1.5%); }
      66%  { transform: scale(0.96) translate(2.5%, -1%); }
      100% { transform: scale(1.05) translate(-1%, 2%); }
