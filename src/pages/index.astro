  <div class="float-video" id="float-video">
    <button class="float-video-close" id="float-video-close" aria-label="動画を閉じる">×</button>
    <div class="float-video-frame"><div id="float-video-player"></div></div>
    <div class="float-video-caption" data-ja="YouTube『ビジネスジャーナルTV』に弊社代表 佐藤・柳澤が出演" data-en="Co-CEOs Sato &amp; Yanagisawa on YouTube 'Business Journal TV'">YouTube『ビジネスジャーナルTV』に弊社代表 佐藤・柳澤が出演</div>
  </div>
  <script is:inline>
    (function () {
      var START = 1720, END = 1920, VID = 'xA09lbcwwJY';
      var holder = document.getElementById('float-video');
      if (!holder) return;
      var tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
      var player = null, poll = null;
      function killCaptions(p) {
        try {
          p.unloadModule('captions'); p.unloadModule('cc');
          p.setOption('captions', 'track', {}); p.setOption('cc', 'track', {});
        } catch (err) {}
      }
      window.onYouTubeIframeAPIReady = function () {
        player = new YT.Player('float-video-player', {
          videoId: VID,
          playerVars: { autoplay: 1, mute: 1, controls: 0, start: START, end: END, playsinline: 1, rel: 0, modestbranding: 1, iv_load_policy: 3, disablekb: 1, fs: 0 },
          events: {
            onReady: function (e) {
              e.target.mute();
              killCaptions(e.target);
              e.target.playVideo();
            },
            onApiChange: function (e) { killCaptions(e.target); },
            onStateChange: function (e) {
              if (e.data === YT.PlayerState.ENDED) { e.target.seekTo(START, true); e.target.playVideo(); }
              if (e.data === YT.PlayerState.PLAYING && !poll) {
                poll = setInterval(function () {
                  var t = player && player.getCurrentTime ? player.getCurrentTime() : 0;
                  if (t >= END - 0.3) player.seekTo(START, true);
                }, 500);
              }
            }
          }
        });
      };
      document.getElementById('float-video-close').addEventListener('click', function () {
        if (poll) clearInterval(poll);
        try { if (player && player.destroy) player.destroy(); } catch (err) {}
        holder.remove();
      });
    })();
  </script>

