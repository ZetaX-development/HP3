  <script>
    // INTRO staging: 縦罫 → 一文字ずつ題字 → 字間が開きタグライン → 幕明け。head の zx-hold ゲートと対で動く。
    const zxIntro = document.getElementById("zx-intro");
    if (zxIntro && document.documentElement.classList.contains("zx-hold")) {
      requestAnimationFrame(() => {
        zxIntro.classList.add("zxi-s1");                        // 縦罫が引かれる
        setTimeout(() => zxIntro.classList.add("zxi-s2"), 450);  // 題字が一文字ずつ浮かぶ＋字間が開く
        setTimeout(() => zxIntro.classList.add("zxi-s3"), 1450); // アクセントラインとタグライン
        setTimeout(() => {
          zxIntro.classList.add("zxi-done");                     // 幕が明ける
          document.documentElement.classList.remove("zx-hold");  // ヒーローの fadeUp 再生開始
        }, 2650);
        setTimeout(() => zxIntro.remove(), 3350);
      });
      try { sessionStorage.setItem("zxIntroSeen", "1"); } catch (e) { /* noop */ }
    } else if (zxIntro) {
      zxIntro.remove();
    }
  </script>

