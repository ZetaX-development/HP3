    .rf-textarea { resize: vertical; min-height: 90px; }
    .rf-submit { width: 100%; font-family: var(--font-jp); font-size: 0.94rem; font-weight: 700; padding: 14px; border-radius: 6px; background: var(--accent); color: #fff; border: none; cursor: pointer; transition: background 0.2s, transform 0.2s; margin-top: 0.4rem; }
    .rf-submit:hover { background: var(--accent-light); transform: translateY(-1px); }
    .rf-submit:disabled { opacity: 0.6; cursor: wait; transform: none; }
    .rf-privacy { font-size: 0.72rem; color: var(--text-dim); margin-top: 0.9rem; line-height: 1.7; }
    .rf-privacy a { color: var(--accent); text-decoration: underline; }
    .rf-success { display: none; text-align: center; padding: 3rem 1rem; }
    .rf-success.show { display: block; }
    .rf-success-icon { font-size: 2rem; color: var(--accent); margin-bottom: 1rem; }
    .rf-success p { font-size: 0.92rem; color: var(--text-secondary); line-height: 2; }
    .rf-error { display: none; font-size: 0.8rem; color: #d43c3c; background: #fdf0f0; border: 1px solid #f2cccc; border-radius: 6px; padding: 0.8rem 1rem; margin-top: 1rem; line-height: 1.8; }
    .rf-error.show { display: block; }
    @media (max-width: 900px) { .request-wrap { grid-template-columns: 1fr; gap: 3rem; } .rf-row { grid-template-columns: 1fr; } }

    /* FAQ */
