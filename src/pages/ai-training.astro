---
import MobileNav from "@components/Nav/MobileNav.astro";
---
<!DOCTYPE html>
<html lang="ja" data-lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>法人向けAI研修・生成AI研修 | ZetaX — 現役AIエンジニアが設計する実務直結型プログラム</title>
  <meta name="description" content="ZetaXのAI研修・リテラシー教育。上場企業・銀行・製造業など30社以上の支援実績。現役AI開発エンジニアが実業務を題材に研修を設計。研修と要件定義のセット提供。資料請求無料。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@200;300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="canonical" href="https://zetax.jp/ai-training/">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: "ZetaX AI研修（法人向けAI研修・生成AI研修）",
    serviceType: "AI研修・リテラシー教育",
    provider: {
      "@type": "Organization",
      name: "ZetaX",
      url: "https://zetax.jp",
    },
    areaServed: "JP",
    description:
      "現役AI開発エンジニアが、現場ヒアリングをもとに貴社の実業務を題材とした法人向けAI研修を設計・実施。研修と要件定義書のセット提供で、学んで終わりではなく明日から使えるところまで伴走します。",
    url: "https://zetax.jp/ai-training/",
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://zetax.jp/" },
      { "@type": "ListItem", position: 2, name: "Services", item: "https://zetax.jp/services/" },
      { "@type": "ListItem", position: 3, name: "AI研修・リテラシー教育", item: "https://zetax.jp/ai-training/" },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "AIについて全く知識がない社員でも参加できますか？",
        acceptedAnswer: { "@type": "Answer", text: "はい、ゼロから始められるプログラムをご用意できます。参加者の現状のリテラシーに合わせてカリキュラムを調整しますので、事前知識は不要です。「スマートフォンを使えれば十分」というレベルから始められます。" },
      },
      {
        "@type": "Question",
        name: "何人から研修を受けられますか？",
        acceptedAnswer: { "@type": "Answer", text: "1名からの個別コーチングにも対応しています。演習の質を保つため受講は各回20名までとし、大人数の場合は回を分けて実施します。数百名規模の全社展開も、回を分けることで対応可能です。" },
      },
      {
        "@type": "Question",
        name: "オンラインと対面、どちらで実施できますか？",
        acceptedAnswer: { "@type": "Answer", text: "両方に対応しています。ハンズオン研修は対面が効果的ですが、オンラインでも十分な成果が出ます。全国どこでも対面での出張研修が可能です（北は青森から南は福岡まで実績あり）。" },
      },
      {
        "@type": "Question",
        name: "研修費用の目安はいくらですか？",
        acceptedAnswer: { "@type": "Answer", text: "回数・時間数に応じたパッケージ料金をご用意しています（時間割・回数・人数は柔軟に調整可能です）。料金表を含む詳細資料は資料請求にて無料でお送りします。ご要望に合わせた個別のお見積りも可能です。" },
      },
      {
        "@type": "Question",
        name: "研修後のフォローアップはありますか？",
        acceptedAnswer: { "@type": "Answer", text: "あります。研修後のQ&Aサポート・追加コンテンツ提供・定期的なフォローアップ研修など、継続的なサポートプランをご用意しています。「研修したけど現場で使われていない」という事態を防ぎます。" },
      },
    ],
  })} />
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #ffffff; --bg-subtle: #f7f8fa; --bg-card: #f9fafb;
      --text-primary: #0d0d14; --text-secondary: #52606d; --text-dim: #9da5b4;
      --accent: #1a3fbf; --accent-light: #3b5fdf; --accent-pale: #eef1fd;
      --border: #e4e7ef; --border-light: #f0f2f6;
      --font-jp: 'Noto Sans JP', sans-serif; --font-en: 'Inter', 'Noto Sans JP', sans-serif;
      --ease: cubic-bezier(0.22,1,0.36,1);
    }
    html { scroll-behavior: smooth; font-size: 16px; overflow-x: hidden; }
    body { font-family: var(--font-jp); background: var(--bg); color: var(--text-primary); line-height: 1.8; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 0 3rem; height: 68px; display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.97); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); transition: box-shadow 0.3s; }
    .nav.elevated { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
    .nav-logo { font-family: var(--font-en); font-size: 1.15rem; font-weight: 700; letter-spacing: 0.12em; }
    .nav-logo span { color: var(--accent); }
    .nav-right { display: flex; align-items: center; }
    .nav-links { display: flex; list-style: none; font-size: 0.82rem; font-weight: 500; }
    .nav-links > li { position: relative; }
    .nav-links > li > a, .nav-links > li > .nav-dropdown-trigger { display: flex; align-items: center; gap: 4px; height: 68px; padding: 0 1.1rem; color: var(--text-secondary); font-size: 0.82rem; font-weight: 500; border: none; background: none; cursor: pointer; transition: color 0.2s; white-space: nowrap; }
    .nav-links > li > a:hover, .nav-links > li > .nav-dropdown-trigger:hover { color: var(--text-primary); }
    .nav-dropdown-arrow { font-size: 0.55rem; opacity: 0.5; transition: transform 0.2s; }
    .nav-links > li:hover .nav-dropdown-arrow { transform: rotate(180deg); }
    .nav-dropdown { position: absolute; top: calc(100% + 2px); left: 50%; transform: translateX(-50%) translateY(-6px); background: #fff; border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.08); padding: 0.6rem 0; min-width: 200px; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.18s var(--ease), transform 0.18s var(--ease); }
    .nav-links > li:hover .nav-dropdown { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0); }
    .nav-dropdown a { display: block; padding: 0.6rem 1.4rem; font-size: 0.82rem; color: var(--text-secondary); transition: background 0.15s, color 0.15s; white-space: nowrap; }
    .nav-dropdown a:hover { background: var(--bg-subtle); color: var(--accent); }
    .nav-dropdown-divider { height: 1px; background: var(--border-light); margin: 0.4rem 0; }
    .nav-dropdown-label { padding: 0.5rem 1.4rem 0.2rem; font-family: var(--font-en); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-dim); }
    .lang-toggle { display: flex; align-items: center; background: var(--bg-card); border-radius: 20px; padding: 3px; margin-left: 1.4rem; border: 1px solid var(--border); }
    .lang-btn { font-family: var(--font-en); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; padding: 5px 13px; border-radius: 16px; border: none; cursor: pointer; background: transparent; color: var(--text-dim); transition: all 0.2s; }
    .lang-btn.active { background: var(--accent); color: #fff; }
    .nav-cta { font-family: var(--font-jp); font-size: 0.82rem; font-weight: 600; padding: 9px 22px; border-radius: 6px; background: var(--accent); color: #fff; margin-left: 1.2rem; transition: background 0.2s, transform 0.2s; white-space: nowrap; }
    .nav-cta:hover { background: var(--accent-light); transform: translateY(-1px); }
    @media (max-width: 768px) { .nav-links, .nav-cta, .lang-toggle { display: none; } .nav { padding: 0 1.5rem; } }

    .container { max-width: 1160px; margin: 0 auto; padding: 0 3rem; }
    .section { padding: 100px 0; }
    .section-alt { background: var(--bg-subtle); }
    .section-label { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-en); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.2rem; }
    .section-label::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
    .section-heading { font-family: var(--font-jp); font-size: clamp(1.5rem, 2.6vw, 2.2rem); font-weight: 700; line-height: 1.3; color: var(--text-primary); }
    .section-sub { font-size: 0.95rem; color: var(--text-secondary); line-height: 2; margin-top: 1rem; max-width: 640px; }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .d1 { transition-delay: 0.1s; } .d2 { transition-delay: 0.2s; } .d3 { transition-delay: 0.3s; }
    @media (max-width: 1024px) { .container { padding: 0 2rem; } }
    @media (max-width: 768px) { .section { padding: 70px 0; } }

    /* HERO — clean white with accent */
    .hero { min-height: 76vh; display: flex; align-items: center; background: var(--bg); padding-top: 68px; position: relative; overflow: hidden; border-bottom: 1px solid var(--border); }
    .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(26,63,191,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(26,63,191,0.04) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 20%, transparent 75%); }
    .hero-blob { position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(26,63,191,0.06) 0%, transparent 70%); top: -150px; right: -150px; pointer-events: none; }
    .hero-content { position: relative; z-index: 1; padding: 5rem 0; }
    .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-en); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); margin-bottom: 2rem; }
    .hero-badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
    .hero-title { font-family: var(--font-jp); font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 700; line-height: 1.25; color: var(--text-primary); margin-bottom: 1.6rem; }
    .hero-title .accent { color: var(--accent); }
    .hero-sub { font-size: clamp(0.9rem, 1.4vw, 1.05rem); color: var(--text-secondary); line-height: 1.9; max-width: 580px; margin-bottom: 2.8rem; }
    .hero-stats { display: flex; gap: 0; border: 1px solid var(--border); margin-bottom: 2.8rem; }
    .hero-stat { padding: 1.2rem 2rem; flex: 1; border-right: 1px solid var(--border); }
    .hero-stat:last-child { border-right: none; }
    .hero-stat-num { font-family: var(--font-en); font-size: 1.7rem; font-weight: 700; color: var(--accent); line-height: 1; margin-bottom: 0.3rem; letter-spacing: -0.02em; }
    .hero-stat-num em { font-style: normal; font-size: 0.58em; }
    .hero-stat-label { font-size: 0.74rem; color: var(--text-dim); line-height: 1.5; }
    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary { font-family: var(--font-jp); font-size: 0.9rem; font-weight: 600; padding: 13px 34px; border-radius: 6px; background: var(--accent); color: #fff; border: none; cursor: pointer; display: inline-block; transition: background 0.2s, transform 0.2s; }
    .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }
    .btn-outline { font-family: var(--font-jp); font-size: 0.9rem; font-weight: 500; padding: 13px 34px; border-radius: 6px; background: transparent; color: var(--text-primary); border: 1.5px solid var(--border); cursor: pointer; display: inline-block; transition: border-color 0.2s, color 0.2s, transform 0.2s; }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

    .breadcrumb { padding: 1.4rem 0; border-bottom: 1px solid var(--border); }
    .breadcrumb-inner { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-en); font-size: 0.72rem; color: var(--text-dim); }
    .breadcrumb-inner a { color: var(--text-dim); transition: color 0.2s; }
    .breadcrumb-inner a:hover { color: var(--accent); }

    /* PROGRAMS */
    .programs-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 4rem; }
    .program-card { background: var(--bg); padding: 2.8rem 2.4rem; transition: background 0.2s; }
    .program-card:hover { background: #fafbff; }
    .program-level { font-family: var(--font-en); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
    .program-name { font-weight: 700; font-size: 1.05rem; color: var(--text-primary); margin-bottom: 0.6rem; line-height: 1.4; }
    .program-target { font-size: 0.76rem; color: var(--accent); background: var(--accent-pale); padding: 3px 10px; border-radius: 2px; display: inline-block; margin-bottom: 1rem; font-weight: 600; }
    .program-desc { font-size: 0.84rem; color: var(--text-secondary); line-height: 1.9; margin-bottom: 1.4rem; }
    .program-items { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
    .program-items li { font-size: 0.8rem; color: var(--text-secondary); padding-left: 1rem; position: relative; }
    .program-items li::before { content: '—'; position: absolute; left: 0; color: var(--accent); font-size: 0.7rem; }
    @media (max-width: 1024px) { .programs-grid { grid-template-columns: 1fr; } }

    /* TARGETS */
    .targets-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 3rem; }
    .target-card { background: var(--bg-subtle); padding: 2rem 1.8rem; text-align: center; }
    .target-icon { font-size: 1.6rem; margin-bottom: 0.8rem; }
    .target-name { font-weight: 700; font-size: 0.9rem; color: var(--text-primary); margin-bottom: 0.4rem; }
    .target-desc { font-size: 0.76rem; color: var(--text-secondary); line-height: 1.7; }
    @media (max-width: 768px) { .targets-grid { grid-template-columns: repeat(2,1fr); } }

    /* FLOW */
    .flow-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 4rem; }
    .flow-step { background: var(--bg); padding: 2.4rem 2rem; position: relative; }
    .flow-num { font-family: var(--font-en); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 0.8rem; }
    .flow-title { font-weight: 700; font-size: 0.92rem; color: var(--text-primary); margin-bottom: 0.6rem; }
    .flow-desc { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.9; }
    @media (max-width: 768px) { .flow-grid { grid-template-columns: repeat(2,1fr); } }

    /* FEATURES */
    .features-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 4rem; }
    .feature-card { background: var(--bg); padding: 2.6rem 2.2rem; transition: background 0.2s; }
    .feature-card:hover { background: #fafbff; }
    .feature-title { font-weight: 700; font-size: 0.96rem; color: var(--text-primary); margin-bottom: 0.8rem; line-height: 1.5; }
    .feature-desc { font-size: 0.84rem; color: var(--text-secondary); line-height: 1.9; }
    @media (max-width: 768px) { .features-grid { grid-template-columns: 1fr; } }

    /* ISSUES */
    .issues-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 4rem; }
    .issue-card { background: var(--bg); padding: 2.6rem 2.2rem; }
    .issue-num { font-family: var(--font-en); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 1rem; }
    .issue-title { font-weight: 700; font-size: 1rem; color: var(--text-primary); line-height: 1.5; margin-bottom: 1rem; }
    .issue-items { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
    .issue-items li { font-size: 0.8rem; color: var(--text-secondary); padding-left: 1rem; position: relative; }
    .issue-items li::before { content: '—'; position: absolute; left: 0; color: var(--accent); font-size: 0.7rem; }
    .issues-band { margin-top: 2.5rem; background: var(--accent-pale); border: 1px solid var(--border); border-radius: 8px; padding: 1.4rem 2rem; text-align: center; font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }
    .issues-band .em { color: var(--accent); }
    @media (max-width: 768px) { .issues-grid { grid-template-columns: 1fr; } }

    /* APPROACH */
    .approach-grid { display: grid; grid-template-columns: 1fr 1fr 1.6fr; gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 4rem; }
    .approach-step { background: var(--bg); padding: 2.4rem 2rem; }
    .approach-step.highlight { background: var(--accent-pale); }
    .approach-num { font-family: var(--font-en); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 0.8rem; }
    .approach-title { font-weight: 700; font-size: 0.96rem; color: var(--text-primary); margin-bottom: 0.6rem; }
    .approach-desc { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.9; }
    .approach-outputs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-top: 1.2rem; }
    .approach-output { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.1rem; }
    .approach-output-name { font-weight: 700; font-size: 0.82rem; color: var(--accent); margin-bottom: 0.3rem; }
    .approach-output-desc { font-size: 0.74rem; color: var(--text-secondary); line-height: 1.7; }
    @media (max-width: 900px) { .approach-grid { grid-template-columns: 1fr; } .approach-outputs { grid-template-columns: 1fr; } }

    /* CURRICULUM TABLE */
    .curriculum-table { margin-top: 4rem; border: 1px solid var(--border); overflow-x: auto; }
    .curriculum-table table { width: 100%; border-collapse: collapse; min-width: 720px; }
    .curriculum-table th { background: var(--text-primary); color: #fff; font-size: 0.78rem; font-weight: 600; text-align: left; padding: 0.9rem 1.3rem; white-space: nowrap; }
    .curriculum-table td { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.8; padding: 1.1rem 1.3rem; border-top: 1px solid var(--border); vertical-align: top; }
    .curriculum-table td.theme { font-weight: 700; color: var(--text-primary); white-space: nowrap; }
    .curriculum-table td.effect { font-weight: 700; color: var(--accent); white-space: nowrap; }
    .curriculum-note { font-size: 0.76rem; color: var(--text-dim); margin-top: 1rem; }

    /* CASES */
    .cases-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 4rem; }
    .case-card { border: 1px solid var(--border); border-radius: 10px; padding: 2.6rem 2.4rem; background: var(--bg); }
    .case-tag { display: inline-block; font-size: 0.72rem; font-weight: 700; color: var(--accent); background: var(--accent-pale); padding: 4px 12px; border-radius: 3px; margin-bottom: 1.2rem; }
    .case-title { font-weight: 700; font-size: 1.08rem; color: var(--text-primary); margin-bottom: 1.2rem; line-height: 1.5; }
    .case-meta { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.6rem; }
    .case-meta li { font-size: 0.82rem; color: var(--text-secondary); display: flex; gap: 0.8rem; }
    .case-meta .k { flex-shrink: 0; width: 4.5em; font-weight: 600; color: var(--text-primary); }
    .case-quote { border-left: 3px solid var(--accent); background: var(--bg-subtle); padding: 1.2rem 1.4rem; font-size: 0.84rem; color: var(--text-secondary); line-height: 2; border-radius: 0 6px 6px 0; }
    .case-quote-label { font-size: 0.7rem; font-weight: 700; color: var(--accent); margin-bottom: 0.4rem; }
    @media (max-width: 900px) { .cases-grid { grid-template-columns: 1fr; } }

    /* REQUEST FORM */
    .request-section { background: var(--text-primary); padding: 100px 0; position: relative; overflow: hidden; }
    .request-mesh { position: absolute; inset: 0; background: radial-gradient(ellipse 70% 80% at 15% 50%, rgba(26,63,191,0.3) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 85% 40%, rgba(123,150,255,0.2) 0%, transparent 55%); pointer-events: none; }
    .request-wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.1fr; gap: 4.5rem; align-items: start; }
