---
import { getCollection } from "astro:content";
import NewsLayout from "@layouts/NewsLayout.astro";

// 技術コラム専用の一覧。記事本体のURLは /news/<slug>/ のまま
const posts = (
  await getCollection(
    "news",
    ({ data }) => data.draft !== true && data.category === "技術コラム",
  )
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = posts[0];
const rest = posts.slice(1);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;

const site = Astro.site ?? new URL("https://zetax.jp");
const ogImage = featured
  ? new URL(featured.data.heroImage.src, site).href
  : undefined;
---

<NewsLayout
  title="技術コラム — AI研修・AI活用の実務ノウハウ | ZetaX"
  description="AI研修・生成AIの業務活用・製造業のAI導入など、現役AIエンジニアが実務目線で解説する技術コラム。"
  ogType="website"
  imageUrl={ogImage}
>
  <section class="section">
    <div class="container">
      <span class="section-label">Column</span>
      <h1 class="section-heading">技術コラム</h1>
      <p class="section-sub">AI研修・生成AIの業務活用・製造業のAI導入について、現役AIエンジニアが実務目線で解説します。<a href="/news/" class="col-backlink">会社ニュースはこちら →</a></p>

      {featured && (
        <a class="news-featured" href={`/news/${featured.id}/`}>
          <img src={featured.data.heroImage.src} alt={featured.data.title} class="news-featured-img" />
          <div class="news-featured-body">
            <span class="news-cat">技術コラム</span>
            <h2 class="news-featured-title">{featured.data.title}</h2>
            <p class="news-featured-desc">{featured.data.description}</p>
            <span class="news-date">{fmtDate(featured.data.pubDate)}</span>
          </div>
        </a>
      )}

      <div class="news-grid">
        {rest.map((p) => (
          <a class="news-card" href={`/news/${p.id}/`}>
            <img src={p.data.heroImage.src} alt={p.data.title} class="news-card-img" />
            <div class="news-card-body">
              <span class="news-cat">技術コラム</span>
              <h3 class="news-card-title">{p.data.title}</h3>
              <span class="news-date">{fmtDate(p.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && <p class="section-sub">まだ記事がありません。</p>}
    </div>
  </section>
</NewsLayout>

<style>
  .col-backlink { color: var(--accent); text-decoration: underline; margin-left: 0.6rem; font-size: 0.85rem; }
  .news-featured { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin: 2rem 0 2.5rem; transition: box-shadow 0.25s; }
  .news-featured:hover { box-shadow: var(--shadow-md); }
  .news-featured-img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; display: block; }
  .news-featured-body { padding: 2rem 2rem 2rem 0; display: flex; flex-direction: column; gap: 0.8rem; justify-content: center; }
  .news-featured-title { font-size: 1.3rem; line-height: 1.5; }
  .news-featured-desc { font-size: 0.88rem; color: var(--text-secondary); }
  .news-cat { display: inline-block; align-self: flex-start; font-size: 0.72rem; font-weight: 600; color: var(--accent); background: var(--accent-pale); padding: 3px 12px; border-radius: 12px; }
  .news-date { font-family: var(--font-en); font-size: 0.78rem; color: var(--text-dim); }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .news-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.25s, transform 0.25s; display: flex; flex-direction: column; }
  .news-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .news-card-img { width: 100%; height: 160px; object-fit: cover; display: block; }
  .news-card-body { padding: 1.2rem 1.4rem 1.4rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .news-card-title { font-size: 0.95rem; line-height: 1.6; flex: 1; }
  @media (max-width: 900px) { .news-grid { grid-template-columns: 1fr; } .news-featured { grid-template-columns: 1fr; } .news-featured-body { padding: 0 1.5rem 1.5rem; } }
</style>
